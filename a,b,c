c.Write a program for responding to events
 Definition: React can listen to user actions (events) like clicks, typing, 
mouse over, etc.
 Use: Makes websites interactive.
App.js file
import React, { useState } from "react";
export default function App() {
const [message, setMessage] = useState("Click the button!");
return (
<div>
<h2>{message}</h2>
<button onClick={() => setMessage("Button was clicked!")}>Click Me</button> </div>
);
}
